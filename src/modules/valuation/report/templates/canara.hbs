{{!-- Kept whole: split across a page boundary it leaves the declaration's
      last clauses stranded above a two-row fragment. --}}
<table class="keep">
  <tr><th class="sn">S. No.</th><th style="width:46%">Particulars</th><th>Valuer comment</th></tr>
  <tr><td class="sn">1</td><td>Background information of the asset being valued</td>
      <td>As detailed in the valuation report</td></tr>
  <tr><td class="sn">2</td><td>Purpose of valuation and appointing authority</td>
      <td>As described on the cover page</td></tr>
  <tr><td class="sn">3</td><td>Identity of the valuer and any other experts involved in the valuation</td>
