{{!--
  Photograph & Location Annexure — always page 2 of the report, and also
  rendered on its own for the editor's "Preview annexure" button.

  One fixed A4 page: the owner/address strip, the site-visit photos packed into
  justified rows whose heights are computed server-side, then the aerial plan
  filling whatever vertical budget the photos did not need.
--}}
{{> report-styles}}
<style>
  .id-strip { margin-bottom: 3mm; }
  .id-strip td.label {
    width: 32%;
    background: var(--navy);
    color: #fff;
    font-weight: 600;
  }
</style>

<h2 class="bar">Photograph &amp; Location Annexure</h2>

<table class="id-strip">
  <tr>
    <td class="label">Name of the Owner/s</td>
    <td>{{or ownerName "N.A."}}</td>
  </tr>
  <tr>
    <td class="label">Address of Property</td>
    <td>{{or consolidatedSiteAddress "N.A."}}</td>
  </tr>
</table>

{{#if photoRows.length}}
<div class="photo-rows">
  {{#each photoRows}}
  <div class="photo-row" style="height: {{this.heightMm}}mm;">
    {{#each this.photos}}
    <div class="photo-cell" style="width: {{this.widthMm}}mm;">
      <img src="{{this.url}}" alt="Site photo" />
    </div>
    {{/each}}
  </div>
  {{/each}}
</div>
{{else}}
<div class="placeholder" style="height: 100mm;">No site-visit photographs uploaded yet.</div>
{{/if}}

{{#if googleEarthPhoto}}
<div class="plate" style="height: {{aerialHeightMm}}mm;">
  <img src="{{googleEarthPhoto}}" alt="Aerial location plan" />
  <span class="plate-label">Aerial Location Plan</span>
</div>
{{else}}
<div class="placeholder" style="height: {{aerialHeightMm}}mm; margin-top: 3mm;">
  No Google Earth image uploaded yet.
</div>
{{/if}}
