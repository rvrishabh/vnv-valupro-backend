// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  CHECKING
  QUERY_RAISED
  APPROVED
  REJECTED
}

enum AUTH_METHOD {
  PASSWORD
  EMAIL_OTP
  GOOGLE
}

enum LoginChannel {
  WEB
  MOBILE
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  LAND
  INDUSTRIAL
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
}

enum QueryType {
  TO_ENGINEER
  TO_BANK
}

enum QueryStatus {
  OPEN
  RESPONDED
  RESOLVED
}

enum ValuationMethod {
  LAND_AND_BUILDING
  CRM
  PLOT
}

enum ValuationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Role {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String?
  loginChannel LoginChannel
  isSystem     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model InstitutionType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  institutions Institution[]
}

model Institution {
  id                String   @id @default(uuid())
  name              String
  code              String   @unique
  institutionTypeId String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  institutionType InstitutionType     @relation(fields: [institutionTypeId], references: [id])
  branches        Branch[]
  users           User[]
  cases           Case[]
  reportTemplate  BankReportTemplate?

  @@index([institutionTypeId])
}

model Branch {
  id                String    @id @default(uuid())
  institutionId     String
  branchName        String
  ifscCode          String?   @unique
  city              String
  state             String
  district          String?
  address           String?
  isManuallyEntered Boolean   @default(false)
  needsVerification Boolean   @default(false)
  verifiedAt        DateTime?
  verifiedById      String?
  createdAt         DateTime  @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  verifiedBy  User?       @relation("BranchVerifiedBy", fields: [verifiedById], references: [id])
  users       User[]
  cases       Case[]

  @@unique([institutionId, branchName, city])
  @@index([institutionId])
  @@index([city])
  @@index([needsVerification])
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  mobile        String?      @unique
  passwordHash  String?
  googleId      String?      @unique
  authMethod    AUTH_METHOD?
  roleId        String
  isActive      Boolean      @default(true)
  isApproved    Boolean      @default(false)
  institutionId String?
  branchId      String?
  fcmToken      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution        Institution?        @relation(fields: [institutionId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  verifiedBranches   Branch[]            @relation("BranchVerifiedBy")
  role               Role                @relation(fields: [roleId], references: [id])
  engineerLocations  EngineerLocation[]
  createdCases       Case[]              @relation("CreatedBy")
  assignedCases      Case[]              @relation("AssignedTo")
  checkedCases       Case[]              @relation("CheckedBy")
  uploadedDocuments  Document[]
  valuationReports   ValuationReport[]
  raisedQueries      Query[]             @relation("RaisedBy")
  receivedQueries    Query[]             @relation("DirectedTo")
  queryResponses     QueryResponse[]
  auditLogs          CaseAuditLog[]
  feeCollections     FeeCollection[]
  valuationEstimates ValuationEstimate[]
}

model EngineerLocation {
  id         String   @id @default(uuid())
  engineerId String
  city       String
  state      String
  createdAt  DateTime @default(now())

  engineer User @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([engineerId, city]) // unique constraint for engineer and city
  @@index([city]) // index for city search
}

model Case {
  id                String       @id @default(uuid())
  caseNumber        String       @unique
  status            CaseStatus   @default(PENDING)
  institutionId     String
  branchId          String?
  createdById       String
  assignedToId      String?
  checkedById       String?
  customerName      String
  customerMobile    String
  propertyLocation  String?
  propertyType      PropertyType
  bankReference     String? // Bank's own loan/case number
  assignedAt        DateTime?
  /// Site engineer opened the visit on the mobile app.
  surveyStartedAt   DateTime?
  /// Site engineer finished the visit and handed the case back.
  surveyCompletedAt DateTime?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  deadline          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  institution   Institution      @relation(fields: [institutionId], references: [id])
  branch        Branch?          @relation(fields: [branchId], references: [id])
  createdBy     User             @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo    User?            @relation("AssignedTo", fields: [assignedToId], references: [id])
  checkedBy     User?            @relation("CheckedBy", fields: [checkedById], references: [id])
  documents     Document[]
  report        ValuationReport?
  auditLogs     CaseAuditLog[]
  queries       Query[]
  feeCollection FeeCollection?

  @@index([status])
  @@index([institutionId])
  @@index([branchId])
  @@index([assignedToId])
  @@index([createdAt])
}

model Document {
  id           String   @id @default(uuid())
  caseId       String
  uploadedById String
  fileName     String
  fileType     String
  s3Key        String
  fileSize     Int
  docType      String // 'bank_doc' | 'site_photo' | 'valuation_report'
  createdAt    DateTime @default(now())

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model ValuationReport {
  id         String @id @default(uuid())
  caseId     String @unique
  engineerId String

  status ValuationStatus @default(DRAFT)
  method ValuationMethod @default(LAND_AND_BUILDING)

  // --- Inputs that drive the calculation (M-Doc / M-Rate) ---
  reportYear         Int?
  tehsil             String?
  /// M-Doc!C105 — the area actually valued. Derived from the deed and site
  /// areas below (the lesser governs), so it is not entered directly.
  plotAreaSqM        Decimal? @db.Decimal(12, 2)
  /// M-Doc!C103 — area of property as typed in the deed.
  areaAsPerDeed      Decimal? @db.Decimal(12, 2)
  /// M-Doc!C104 — area measured on site; mirrors the deed until overridden.
  areaAsPerSite      Decimal? @db.Decimal(12, 2)
  /// M-Doc!C91 — unit the four side measurements are captured in.
  dimensionUnit      String?  @default("ft")
  areaUnit           String?  @default("Sq.m")
  yearOfConstruction Int?
  expectedLifeYears  Int?     @default(80)

  /// M-Doc!C8 — "Specify Type of Property" (House/Flat/Shop/...). Distinct from
  /// Case.propertyType, which is the broader RESIDENTIAL/COMMERCIAL class.
  propertyType         String?
  /// M-Doc!C10
  advanceReceived      Decimal? @db.Decimal(15, 2)
  /// M-Doc!C55
  assetsSoldAsPerDeed  String?
  /// M-Doc!C62 — Freehold | Leasehold. Drives the lease block below.
  tenure               String?
  /// M-Doc!C63:C69 — only meaningful when tenure is Leasehold.
  leaseDetails         Json?
  /// M-Doc!C41:C52 — address as observed on site, alongside the deed address.
  siteAddress          Json?
  /// M-Doc!C80:C87 — boundary/ownership discrepancy checks and road frontage.
  discrepancy          Json?
  /// M-Doc!C26 — documents produced by the bank/owner for the valuation.
  documentsReceived    String?
  /// M-Doc!C28 — GPS reading taken at the site.
  gpsCoordinates       String?
  /// M-Doc!C115:C118 — living rooms, bedrooms, water closets, kitchen.
  rooms                Json?
  /// M-Doc!C122:C124 — total floors, floor the unit sits on, flat type.
  floorDetails         Json?
  /// M-Doc!C127 — free-text summary of what the engineer saw on site.
  briefDescription     String?
  /// M-Doc!C108 — Plot Area / Super Area / Builtup Area / Carpet Area. The
  /// method of valuation sets the default (CRM implies Super Area).
  areaBasis            String?
  /// M-Doc!C110 — only meaningful for a Flat (entered) or Shop (the area
  /// under consideration); otherwise the share is not stated in the documents.
  undividedShareOfLand Decimal? @db.Decimal(12, 2)

  prevailingMarketRate Decimal? @db.Decimal(15, 2)
  circleRate           Decimal? @db.Decimal(15, 2)
  adoptedRate          Decimal? @db.Decimal(15, 2)
  plotPosition         String?
  superAreaPercent     Decimal? @default(0) @db.Decimal(6, 4)

  // --- Narrative / repeating sections, rendered straight into the template ---
  titleDeed      Json?
  boundaries     Json?
  dimensions     Json?
  buildingSpecs  Json?
  floors         Json?
  generalDetails Json?
  extraItems     Json?
  services       Json?
  siteVisit      Json?

  // --- Computed outputs (engine); persisted so reports are reproducible ---
  landValue                  Decimal?  @db.Decimal(15, 2)
  buildingValueDepreciated   Decimal?  @db.Decimal(15, 2)
  extraItemsValue            Decimal?  @db.Decimal(15, 2)
  totalMarketValue           Decimal?  @db.Decimal(15, 2)
  roundedMarketValue         Decimal?  @db.Decimal(15, 2)
  realizableValue            Decimal?  @db.Decimal(15, 2)
  distressValue              Decimal?  @db.Decimal(15, 2)
  insurableValue             Decimal?  @db.Decimal(15, 2)
  compositeRate              Decimal?  @db.Decimal(15, 2)
  landComponentRate          Decimal?  @db.Decimal(15, 2)
  depreciatedBuildingRate    Decimal?  @db.Decimal(15, 2)
  fairMarketValue            Decimal?  @db.Decimal(15, 2)
  guidelineLandValue         Decimal?  @db.Decimal(15, 2)
  guidelineConstructionValue Decimal?  @db.Decimal(15, 2)
  guidelineTotalValue        Decimal?  @db.Decimal(15, 2)
  groundCoveragePercent      Decimal?  @db.Decimal(6, 2)
  farAchieved                Decimal?  @db.Decimal(6, 2)
  /// Full engine output, kept verbatim so the PDF never recomputes.
  computed                   Json?
  computedAt                 DateTime?
  engineVersion              String?

  // --- Legacy summary columns retained for existing consumers ---
  marketValue     Decimal? @db.Decimal(15, 2)
  recommendedLoan Decimal? @db.Decimal(15, 2)

  engineerNotes  String?
  visitLat       Float?
  visitLng       Float?
  visitStartedAt DateTime?
  visitEndedAt   DateTime?
  checkerNotes   String?
  checkerStatus  String? // 'pending' | 'approved' | 'rejected'
  reportPdfS3Key String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  case     Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  engineer User @relation(fields: [engineerId], references: [id])

  @@index([status])
  @@index([engineerId])
}

/// Govt. construction rates keyed by tehsil, backing the workbook's
/// VLOOKUP into 'Construction Rates'. Category 1 = Good/Normal, 2 = Average.
model ConstructionRate {
  id        String   @id @default(cuid())
  tehsil    String
  roofType  String
  category  Int      @default(1)
  rate      Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tehsil, roofType, category])
  @@index([tehsil])
}

/// Govt. guideline (circle) land rates by locality.
model CircleRate {
  id            String    @id @default(cuid())
  tehsil        String
  locality      String
  rate          Decimal   @db.Decimal(15, 2)
  unit          String    @default("Sq.m")
  effectiveFrom DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tehsil, locality])
  @@index([tehsil])
}

/// Dropdown master data (the workbook's hidden `Lists` sheet), so the admin UI
/// and DTO validation share one source of allowed values.
model ValuationOption {
  id        String   @id @default(cuid())
  group     String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  /// Added by a valuer rather than extracted from the workbook. Kept apart so
  /// re-seeding from a revised book never silently drops a locality someone
  /// entered in the field.
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([group, value])
  @@index([group])
}

/// Which report template an institution's PDF is rendered from.
model BankReportTemplate {
  id            String   @id @default(cuid())
  institutionId String   @unique
  templateKey   String
  sections      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
}

model FeeCollection {
  id                 String      @id @default(uuid())
  caseId             String      @unique
  engineerId         String
  standardFee        Decimal     @db.Decimal(10, 2)
  collectedAmount    Decimal     @db.Decimal(10, 2)
  paymentMode        PaymentMode
  utrNumber          String? // for UPI
  receiptPhotoS3Key  String? // for cash
  customerConfirmed  Boolean     @default(false)
  discrepancyFlagged Boolean     @default(false)
  discrepancyAmount  Decimal?    @db.Decimal(10, 2)
  notes              String?
  collectedAt        DateTime?
  createdAt          DateTime    @default(now())

  case     Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  engineer User @relation(fields: [engineerId], references: [id])
}

model Query {
  id           String      @id @default(uuid())
  caseId       String
  raisedById   String
  directedToId String
  queryType    QueryType
  message      String
  status       QueryStatus @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  case       Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  raisedBy   User            @relation("RaisedBy", fields: [raisedById], references: [id])
  directedTo User            @relation("DirectedTo", fields: [directedToId], references: [id])
  responses  QueryResponse[]
}

model QueryResponse {
  id            String   @id @default(uuid())
  queryId       String
  respondedById String
  message       String
  attachments   String[] // S3 keys
  createdAt     DateTime @default(now())

  query       Query @relation(fields: [queryId], references: [id], onDelete: Cascade)
  respondedBy User  @relation(fields: [respondedById], references: [id])
}

model CaseAuditLog {
  id        String   @id @default(uuid())
  caseId    String
  actorId   String
  action    String
  oldStatus String?
  newStatus String?
  notes     String?
  createdAt DateTime @default(now())

  case  Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])
}

model ValuationConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ValuationEstimate {
  id                       String   @id @default(cuid())
  ownerName                String
  address                  String
  plotAreaSqFt             Float
  plotAreaSqM              Float
  estimatedAmount          Float
  rate                     Float
  coveragePercent          Float
  totalPermissibleAreaSqFt Float
  groundFloorAreaSqFt      Float
  floorBreakdown           Json
  createdBy                String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
}
